{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ProjectAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "capabilities",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "viewer",
            "analyst"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "project:read",
              "task_draft:create"
            ]
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "display_name",
        "email",
        "projects",
        "csrf_token",
        "expires_at"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/UUID"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectAccess"
          }
        },
        "csrf_token": {
          "type": "string",
          "minLength": 32
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "CreateTaskDraftCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "create_task_draft"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "去除首尾 Unicode 空白后为 1–120 个 Unicode 字符。"
            }
          }
        }
      }
    },
    "CommandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "project_id",
        "kind",
        "state",
        "task_id",
        "task_title",
        "task_state",
        "version",
        "accepted_at"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/UUID"
        },
        "project_id": {
          "$ref": "#/$defs/UUID"
        },
        "kind": {
          "type": "string",
          "const": "create_task_draft"
        },
        "state": {
          "type": "string",
          "const": "accepted"
        },
        "task_id": {
          "$ref": "#/$defs/UUID"
        },
        "task_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "task_state": {
          "type": "string",
          "const": "draft"
        },
        "version": {
          "type": "string",
          "const": "1"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "APIError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unauthenticated",
            "session_expired",
            "identity_not_provisioned",
            "csrf_invalid",
            "project_forbidden",
            "origin_forbidden",
            "command_not_found",
            "idempotency_conflict",
            "request_too_large",
            "unsupported_media_type",
            "service_unavailable",
            "internal_error",
            "route_not_found",
            "method_not_allowed"
          ]
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/UUID"
        }
      }
    }
  }
}
