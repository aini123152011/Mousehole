# 本文件只展示变量，不由脚本自动读取；在当前终端显式设置需要的变量。
# 下列密码是公开本地占位值，Compose 只绑定 127.0.0.1。
MOUSEHOLE_MODE=development
MOUSEHOLE_DATABASE_URL=postgres://mousehole:mousehole-local-only@127.0.0.1:55432/mousehole?sslmode=disable
MOUSEHOLE_TEST_DATABASE_URL=postgres://mousehole:mousehole-local-only@127.0.0.1:55432/mousehole_test?sslmode=disable
MOUSEHOLE_LISTEN_ADDR=127.0.0.1:8080
MOUSEHOLE_PUBLIC_URL=http://127.0.0.1:8080
MOUSEHOLE_WEB_ORIGIN=http://127.0.0.1:5173
MOUSEHOLE_OIDC_ISSUER=http://127.0.0.1:9090
MOUSEHOLE_OIDC_CLIENT_ID=mousehole-local
MOUSEHOLE_OIDC_CLIENT_SECRET=<仅在当前终端设置的 OIDC client secret>
MOUSEHOLE_AUTH_KEY=<32 字节随机值的标准 base64，仅在当前终端设置>
MOUSEHOLE_SESSION_IDLE_TTL=30m
MOUSEHOLE_SESSION_ABSOLUTE_TTL=8h
MOUSEHOLE_TEST_OIDC_SUBJECT=mousehole-local-analyst
